SHEET_ID=
REDIS_URL=
# Model for every claude call (--model), also stored in the result's "model" field.
# Pinned so a change of the account default can't change output mid forward test.
CLAUDE_MODEL=claude-sonnet-5-5
# worker.main_news only: how many days of headlines to show the model (Mondays
# reach back at least 3 days, over the weekend).
NEWS_LOOKBACK_DAYS=2
# Seconds worker.main_news waits before chaining into worker.main_final. See
# claude_cli.py / main_news.py for why this exists.
FINAL_SYNTHESIS_DELAY_SECONDS=5
# Optional. A Messaging API channel access token (LINE Developers Console) —
# if set, worker.main_final broadcasts the final recommendation to every
# follower of that LINE Official Account. Leave unset to skip broadcasting.
LINE_CHANNEL_ACCESS_TOKEN=
# Optional. Your own LINE user ID (U..., LINE Developers Console > channel >
# Basic settings > "Your user ID"). If set, failure alerts are pushed to this
# user only instead of broadcast to every follower.
LINE_ADMIN_USER_ID=
